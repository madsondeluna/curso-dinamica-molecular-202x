title                    = Martini 3 NPT equilibration, protein restrained
define                   = -DPOSRES -DPOSRES_FC=1000
integrator               = md
dt                       = 0.010            ; 10 fs during equilibration
nsteps                   = 50000            ; 0.5 ns
nstxout-compressed       = 1000             ; every 10 ps
nstenergy                = 100
nstlog                   = 1000
; Martini 3 nonbonded settings
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz
verlet-buffer-tolerance  = 0.005
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15               ; relative dielectric constant (implicit screening)
epsilon_rf               = 0                ; infinite dielectric beyond the cutoff
vdw_type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1
tcoupl                   = v-rescale
tc-grps                  = Protein non-Protein
tau_t                    = 1.0 1.0
ref_t                    = 310 310
pcoupl                   = c-rescale
pcoupltype               = isotropic
tau_p                    = 12.0
compressibility          = 3e-4
ref_p                    = 1.0
refcoord_scaling         = all
gen_vel                  = yes
gen_temp                 = 310
gen_seed                 = -1
