title                    = Martini 3 DSPC bilayer, semi-isotropic equilibration
integrator               = md
dt                       = 0.020            ; 20 fs
nsteps                   = 250000           ; 5 ns
nstxout-compressed       = 2500             ; every 50 ps
nstenergy                = 500
nstlog                   = 5000
comm-mode                = linear
; Martini 3 nonbonded settings
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz
verlet-buffer-tolerance  = 0.005
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15               ; relative dielectric constant (implicit screening)
epsilon_rf               = 0                ; infinite dielectric beyond the cutoff
vdw_type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1
tcoupl                   = v-rescale
tc-grps                  = DSPC W
tau_t                    = 1.0 1.0
ref_t                    = 340 340
pcoupl                   = c-rescale
pcoupltype               = semiisotropic    ; plano xy e normal z acoplados separadamente
tau_p                    = 4.0
compressibility          = 3e-4 3e-4
ref_p                    = 1.0 1.0
continuation             = yes
gen_vel                  = no
