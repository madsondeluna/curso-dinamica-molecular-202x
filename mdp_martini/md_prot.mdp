title                    = Martini 3 production, protein in water
integrator               = md
dt                       = 0.020            ; 20 fs
nsteps                   = 750000           ; 15 ns
nstxout-compressed       = 2500             ; every 50 ps
nstenergy                = 500
nstlog                   = 5000
; Martini 3 nonbonded settings
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz
verlet-buffer-tolerance  = 0.005
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15               ; relative dielectric constant (implicit screening)
epsilon_rf               = 0                ; infinite dielectric beyond the cutoff
vdw_type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1
tcoupl                   = v-rescale
tc-grps                  = Protein non-Protein
tau_t                    = 1.0 1.0
ref_t                    = 310 310
pcoupl                   = c-rescale
pcoupltype               = isotropic
tau_p                    = 12.0
compressibility          = 3e-4
ref_p                    = 1.0
continuation             = yes
gen_vel                  = no
